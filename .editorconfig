# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false

# Not expressible in EditorConfig: this repository writes JavaScript, JSON and
# YAML without trailing commas. Keep them out by hand, or with a formatter
# configured to the same rule.
